[Unit]
Description=ethtool Prometheus exporter
Documentation=https://github.com/eth-exporter/eth-exporter#readme
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ethtool_exporter
Group=ethtool_exporter
# Create once: useradd -r -s /usr/sbin/nologin -M ethtool_exporter

ExecStart=/usr/local/bin/ethtool_exporter \
  --web.listen-address=127.0.0.1:9417 \
  --collector.device-exclude=^(lo|docker.*|veth.*|br-.*|virbr.*)$

Restart=on-failure
RestartSec=5

# Least privilege: only the caps needed for ethtool / AF_PACKET.
# Drop CAP_NET_RAW (and --collector.neighbor=false, or build -tags noneighbor)
# if LLDP/CDP capture is not required.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true

# Harden process environment. Keep host network (default) for iface visibility.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# Optional TLS / basic auth (chmod 640, owner root:ethtool_exporter):
# ExecStart=... --web.config.file=/etc/ethtool_exporter/web-config.yml

# Resource ceilings reduce scrape DoS blast radius.
LimitNOFILE=1024
MemoryMax=256M
TasksMax=64
Nice=5

[Install]
WantedBy=multi-user.target
