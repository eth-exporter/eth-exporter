          "expr": "max by (job, instance, device, role, mode, active_slave, mii_status, slave_state, primary, lacp_partner) (ethtool_bond_info{job=~\"$job\", instance=~\"$instance\", device=~\"$device\"})",
          "legendFormat": "__auto",
