      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "Value": true
            },
            "indexByName": {
              "instance": 0,
              "device": 1,
              "state": 2,
              "port_no": 3,
              "priority": 4,
              "path_cost": 5,
              "hairpin": 6
            },
            "renameByName": {
              "instance": "Instance",
              "device": "Interface",
              "state": "STP state",
              "port_no": "Port",
              "priority": "Priority",
              "path_cost": "Path cost",
              "hairpin": "Hairpin"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
