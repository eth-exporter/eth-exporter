        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "Value": true
            },
            "indexByName": {
              "instance": 0,
              "device": 1,
              "role": 2,
              "mode": 3,
              "mii_status": 4,
              "slave_state": 5,
              "active_slave": 6,
              "primary": 7,
              "lacp_partner": 8
            },
            "renameByName": {
              "instance": "Instance",
              "device": "Interface",
              "role": "Role",
              "mode": "Mode",
              "mii_status": "MII",
              "slave_state": "Slave state",
              "active_slave": "Active slave",
              "primary": "Primary",
              "lacp_partner": "LACP partner"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
