        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ethtool_bond_mii_up{job=~\"$job\", instance=~\"$instance\", device=~\"$device\"} == 0) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
