      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "LLDP / CDP neighbors",
      "collapsed": false,
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Neighbors",
      "description": "Learned passively via AF_PACKET. Free-text columns are empty when --collector.neighbor.redact is set.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, instance, device, protocol, chassis_id, port_id, system_name, port_desc, management_address, platform, vlan, capabilities) (ethtool_neighbor_info{job=~\"$job\", instance=~\"$instance\", device=~\"$device\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, instance, device, protocol, chassis_id, port_id) (time() - ethtool_neighbor_last_seen_seconds{job=~\"$job\", instance=~\"$instance\", device=~\"$device\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, instance, device, protocol, chassis_id, port_id) (ethtool_neighbor_ttl_seconds{job=~\"$job\", instance=~\"$instance\", device=~\"$device\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "Value #A": true
            },
            "indexByName": {
              "instance": 0,
              "device": 1,
              "protocol": 2,
              "system_name": 3,
              "port_id": 4,
              "port_desc": 5,
              "management_address": 6,
              "vlan": 7,
              "platform": 8,
              "capabilities": 9,
              "chassis_id": 10,
              "Value #B": 11,
              "Value #C": 12
            },
            "renameByName": {
              "instance": "Instance",
              "device": "Interface",
              "protocol": "Protocol",
              "system_name": "Neighbor",
              "port_id": "Port ID",
              "port_desc": "Port description",
              "management_address": "Management",
              "vlan": "VLAN",
              "platform": "Platform",
              "capabilities": "Capabilities",
              "chassis_id": "Chassis ID",
              "Value #B": "Last PDU",
              "Value #C": "TTL"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last PDU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TTL"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Bonding, bridging, and SR-IOV",
      "collapsed": false,
