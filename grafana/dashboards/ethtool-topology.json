            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "disabled",
                        "index": 0,
                        "color": "text"
                      },
                      "1": {
                        "text": "listening",
                        "index": 1,
                        "color": "yellow"
                      },
